{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaapp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "51f1bd77-ffc2-4355-b245-cfb1139782b5","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "512436c534544269b1ffe8bc06832263" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
